{
  "name": "titan-racers",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p room-server",
    "test:e2e": "playwright test",
    "rooms:dev": "WRANGLER_SEND_METRICS=false wrangler dev --config room-server/wrangler.jsonc",
    "rooms:check": "WRANGLER_SEND_METRICS=false wrangler deploy --config room-server/wrangler.jsonc --env production --dry-run --outdir .wrangler/dry-run",
    "rooms:deploy": "WRANGLER_SEND_METRICS=false wrangler deploy --config room-server/wrangler.jsonc --env production",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "tsx scripts/migrate-production.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:anonymize-user": "tsx scripts/anonymize-user.ts",
    "db:reset-course-seed": "tsx scripts/reset-course-seed.ts",
    "docs:generate-kart-catalog": "tsx scripts/generate-kart-catalog.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.16",
    "@better-auth/passkey": "^1.7.16",
    "@simplewebauthn/browser": "^13.3.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.16",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.6",
    "pg": "^8.22.0",
    "playcanvas": "2.20.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.57.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "wrangler": "4.151.3"
  }
}
